# Copy to .env and adjust. Never commit real secrets.

# --- Database ------------------------------------------------------------
# Superuser/DDL connection, used only by migrations (pnpm db:migrate).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/haij
# Application role: all domain queries, fully subject to RLS.
APP_DATABASE_URL=postgres://haij_app:haij_app@localhost:5432/haij
# Better Auth role: auth tables only.
AUTH_DATABASE_URL=postgres://haij_auth:haij_auth@localhost:5432/haij

# --- CVR lookup ----------------------------------------------------------
# Provider for company lookups:
#   "virk"   official system-to-system access (requires credentials below)
#   "cvrapi" public cvrapi.dk (quota-limited per IP)
#   "none"   disable lookups; manual entry only
CVR_PROVIDER=cvrapi
# Contact for the identifying User-Agent that cvrapi.dk's terms require,
# e.g. an email address. Falls back to BETTER_AUTH_URL if unset.
CVR_CONTACT=
# Credentials for distribution.virk.dk when CVR_PROVIDER=virk.
VIRK_CVR_USER=
VIRK_CVR_PASSWORD=

# --- Better Auth ---------------------------------------------------------
# Dev-only default so the quickstart works out of the box.
# In production ALWAYS generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production
# Public base URL of the app (passkeys bind to this origin).
BETTER_AUTH_URL=http://localhost:3000

# --- Registration --------------------------------------------------------
# Who may create an account. "closed" (the default) admits the very first
# user on an empty installation and nobody after that; "open" lets anyone
# register, which is for a demo instance, not for a company's own Haij.
SIGNUP=closed

# LLM adapter: "mistral" (EU-hosted API), "ollama" (local, Ollama-compatible)
# or "none" to disable AI features. The Mistral key is a secret: it lives
# only here locally and in Coolify in production - never in the repo.
LLM_PROVIDER=none
# MISTRAL_API_KEY=
# LLM_MODEL=mistral-small-latest
# OLLAMA_BASE_URL=http://localhost:11434
