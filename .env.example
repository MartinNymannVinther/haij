# Copy to .env and adjust. Never commit real secrets.

# --- Database ------------------------------------------------------------
# Superuser/DDL connection, used only by migrations (pnpm db:migrate).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/haij
# Application role: all domain queries, fully subject to RLS.
APP_DATABASE_URL=postgres://haij_app:haij_app@localhost:5432/haij
# Better Auth role: auth tables only.
AUTH_DATABASE_URL=postgres://haij_auth:haij_auth@localhost:5432/haij

# --- CVR lookup ----------------------------------------------------------
# Provider for company lookups: "cvrapi" (public cvrapi.dk, quota-limited)
# or "none" to disable lookups and use manual entry only.
CVR_PROVIDER=cvrapi
# Contact for the identifying User-Agent that cvrapi.dk's terms require,
# e.g. an email address. Falls back to BETTER_AUTH_URL if unset.
CVR_CONTACT=

# --- Better Auth ---------------------------------------------------------
# Dev-only default so the quickstart works out of the box.
# In production ALWAYS generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production
# Public base URL of the app (passkeys bind to this origin).
BETTER_AUTH_URL=http://localhost:3000
